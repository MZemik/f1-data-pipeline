# Neon Postgres connection (direct, non-pooled connection string)
# Get this from the Neon dashboard -> Connection Details
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require

# Dev-only: limit extract.py to the first N rounds of the season, to cut API
# calls while testing. Leave unset for a normal full-season run.
# EXTRACT_ROUND_LIMIT=2
